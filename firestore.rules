rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Journal Entries: allow updates/deletions strictly within the 7-day grace period from system creation time
    match /users/{userId}/entries/{entryId} {
      allow read, create: if isOwner(userId);
      allow update, delete: if isOwner(userId) && (
        ('Created_At' in resource.data && (request.time - resource.data.Created_At < duration.value(7, 'd'))) ||
        ('createdAt' in resource.data && (request.time - resource.data.createdAt < duration.value(7, 'd')))
      );
    }

    // Isolate user data: A user can read/write their other subcollections (reminders, usage, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Deny access to any other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

